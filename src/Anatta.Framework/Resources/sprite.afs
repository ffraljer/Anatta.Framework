#version 450

layout(location = 0) in vec2 vTex;
layout(location = 0) out vec4 FragColor;
layout(binding = 1) uniform sampler2D tex;
layout(binding = 0) uniform Constants {
    mat4 transform;
    mat4 uProjection;
    vec4 uTintTop;
    vec4 uTintBottom;
    vec4 uBorderTop;
    vec4 uBorderBottom;
    vec2 uSize;
    float uRadius;
    float uCircleRadius;
    float uCircleThickness;
    float BoxBorderThickness;
};

void main()
{
    vec2 p = vTex * uSize;
    float t = p.y / uSize.y;
    vec4 fillColor = mix(uTintTop, uTintBottom, t);
    vec4 borderColor = mix(uBorderTop, uBorderBottom, t);

    vec4 color = texture(tex, vTex);

    if (uCircleRadius <= 0.0) { // box
        if (uRadius > 0.0) { // rounded
            float dx = max(uRadius - p.x, 0.0);
            dx = max(dx, max(uRadius - (uSize.x - p.x), 0.0));

            float dy = max(uRadius - p.y, 0.0);
            dy = max(dy, max(uRadius - (uSize.y - p.y), 0.0));

            float dist = length(vec2(dx, dy));
            float aa = fwidth(dist);
            float a = 1.0 - smoothstep(uRadius - aa, uRadius + aa, dist);

            if (a <= 0.0)
                discard;
             if (BoxBorderThickness > 0.0) {
                float innerRadius = max(uRadius - BoxBorderThickness, 0.0);
                vec2 innerSize = uSize - vec2(BoxBorderThickness * 2.0);
                vec2 innerP = p - vec2(BoxBorderThickness);

                float idx = max(innerRadius - innerP.x, 0.0);
                idx = max(idx, max(innerRadius - (innerSize.x - innerP.x), 0.0));

                float idy = max(innerRadius - innerP.y, 0.0);
                idy = max(idy, max(innerRadius - (innerSize.y - innerP.y), 0.0));

                float innerDist = length(vec2(idx, idy));
                float innerAA = fwidth(innerDist);
                float innerA = 1.0 - smoothstep(innerRadius - innerAA, innerRadius + innerAA, innerDist);

                float borderA = a - innerA * a;

                borderColor.a *= borderA;
                fillColor.a   *= innerA * a;

                vec4 fcol = fillColor;
                fcol.rgb = fillColor.rgb * fillColor.a + borderColor.rgb * borderColor.a * (1.0 - fillColor.a);
                fcol.a   = fillColor.a + borderColor.a * (1.0 - fillColor.a);

                color = fcol * texture(tex, vTex);
            } else {
                fillColor.a *= a;
                color = fillColor * texture(tex, vTex);
            }
        } else { // sharp box
            if (BoxBorderThickness > 0.0) {
                float edgeDist = min(min(p.x, uSize.x - p.x), min(p.y, uSize.y - p.y));
                float aa = fwidth(edgeDist);

                float outerA = smoothstep(-aa, aa, edgeDist);

                float innerDist = edgeDist - BoxBorderThickness;
                float innerA = smoothstep(-aa, aa, innerDist);

                float borderA = outerA - innerA;

                borderColor.a *= borderA;
                fillColor.a   *= innerA;

                vec4 fcol;
                fcol.rgb = fillColor.rgb * fillColor.a + borderColor.rgb * borderColor.a * (1.0 - fillColor.a);
                fcol.a   = fillColor.a + borderColor.a * (1.0 - fillColor.a);

                color = fcol * texture(tex, vTex);

                if (color.a <= 0.0)
                    discard;
            } else {
                color *= fillColor;
            }
        }
    }
    else { // circle
        vec2 center = uSize * 0.5;
        float dist = length(p - center);
        float aa = fwidth(dist);

        float innerRadius = uCircleRadius - uCircleThickness;
        float fillAlpha = 1.0 - smoothstep(innerRadius - aa, innerRadius + aa, dist);

        float borderAlpha = 0.0;
        if (uCircleThickness > 0.0) {
            borderAlpha = smoothstep(innerRadius - aa, innerRadius + aa, dist) - 
                          smoothstep(uCircleRadius - aa, uCircleRadius + aa, dist);
        }

        fillColor.a *= fillAlpha;
        borderColor.a *= borderAlpha;

        vec4 tcol = texture(tex, vTex);
        
        vec4 fcol = fillColor + borderColor * (1.0 - fillColor.a);
        
        fcol.rgb *= tcol.rgb;
        fcol.a *= tcol.a;
        
        color = fcol;
        
        color = fcol;

        if (color.a <= 0.0)
            discard;
    }

    FragColor = color;
}