<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Anatta.Framework</RootNamespace>

        <PackageId>Anatta.Framework</PackageId>
        <Version>2026.06.09</Version>
        <Authors>fråljer</Authors>
        <Company>fråljer</Company>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>A probably cross-platform game framework.</Description>
        <PackageProjectUrl>https://github.com/theykilledfraljer/Anatta.Framework</PackageProjectUrl>
        <RepositoryUrl>https://github.com/theykilledfraljer/Anatta.Framework</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <DefineConstants>WINDOWS;win;Windows</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
      <PackageReference Include="ManagedBass" Version="4.0.2" />
      <PackageReference Include="ManagedBass.Fx" Version="4.0.2" />
      <PackageReference Include="OpenTK" Version="5.0.0-pre.15" />
      <PackageReference Include="SDL3-CS" Version="3.5.0-preview.20260213-150035" />
      <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
      <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
      <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))"> <!--what the fuck are with XML comments-->
        <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
        <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
        <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
        <PackageReference Include="Vortice.ShaderCompiler" Version="1.9.0" />
        <PackageReference Include="Vortice.SpirvCross" Version="1.5.4" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Resources\**\*" />
    </ItemGroup>
    <ItemGroup>
        <None Update="runtimes\linux-x64\native\libbass.so">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="runtimes\win-x64\native\bass.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="runtimes\win-x64\native\SDL3.dll">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>